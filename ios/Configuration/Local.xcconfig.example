// Copy this file to Local.xcconfig in the same folder, then uncomment the
// settings you need and replace their values. Local.xcconfig is gitignored and
// is included at the end of Callma.xcconfig, so every setting you uncomment
// overrides the checked-in default. A fresh copy changes nothing.
//
// "//" starts a comment anywhere on a line: never paste a value that contains
// it (for example a wss:// URL).

// Your 10-character Apple Team ID. Set it here, not in Signing & Capabilities.
// Free Personal Team: Keychain Access > your "Apple Development" certificate >
// Organizational Unit (not the code shown in the certificate's name).
// DEVELOPMENT_TEAM = ABCDE12345

// Must be unique to you: Xcode cannot register an identifier that another
// team already uses.
// PRODUCT_BUNDLE_IDENTIFIER = com.example.yourname.Callma

// false = production phone interface (required for LiveKit calling).
// CALLMA_DEMO = false

// Replace both lines with the two lines printed by
// backend/AI Deepfake Pipeline/LiveKit Setup/tools/mint_lobby_token.py
// The host is the LiveKit project host only: no wss://, no path.
// The token is a credential and it expires; mint a new one when it does.
// CALLMA_LIVEKIT_HOST = your-project.livekit.cloud
// CALLMA_LOBBY_TOKEN = paste-the-token-here
