# LiveKit project CAC; keep the filled .env.local out of Git.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Default is real. stub is for plumbing tests only.
DETECTOR=real
# DETECTOR_WEIGHTS_DIR=/absolute/path/to/AI Deepfake Pipeline
# DETECTOR_DEVICE=mps
SCORE_EVERY_SEC=1
RECORD_CALLER_AUDIO=0
SENIOR_IDENTITY=senior
SENIOR_LOBBY_ROOM=senior-lobby
RING_TIMEOUT_SEC=30

# Same 16 kHz caller stream -> local Vosk -> existing JEV connector.
TRANSCRIPT_ENABLED=1
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15
TRANSCRIPT_SCORE_URL=http://127.0.0.1:3000/v1/jev/probability
TRANSCRIPT_SCORE_EVERY_SEC=2.5
TRANSCRIPT_SCORE_TIMEOUT_SEC=4
TRANSCRIPT_MAX_AGE_SEC=15

# Optional saved scam transcript excerpts. OFF by default.
# Enable only for controlled test calls after every participant explicitly consents.
# This setting does not implement a call-start notice or obtain consent.
SAVE_SCAM_TRANSCRIPTS=0
